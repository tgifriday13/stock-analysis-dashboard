# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Recommended by SEC for polite API access (your name + email)
# Example: "Jane Smith jane@example.com"
SEC_USER_AGENT=

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Required for stable macro data (FRED series). Leave blank to skip.
FRED_API_KEY=
